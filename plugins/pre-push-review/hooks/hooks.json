{
  "description": "pre-push-review の配送経路: PreToolUse (Bash) で未レビューの git push を deny (block-pre-push.sh)、codex review wrapper の background 起動を deny (block-bg-codex-wrapper.sh)。Claude Code は PostToolUse (*) の auto-mark.sh、Codex は SubagentStop の codex-auto-mark.sh で namespaced/named review agent の完了を検証し、レビュー済みマーカーを更新する。マーカー仕様・保証差は plugin README を参照。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/block-pre-push.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/block-bg-codex-wrapper.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/auto-mark.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^pre-push-(correctness|independent|security)-reviewer$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/codex-auto-mark.sh\""
          }
        ]
      }
    ]
  }
}
