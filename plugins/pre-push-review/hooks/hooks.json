{
  "description": "pre-push-review の配送経路: PreToolUse (Bash) で未レビューの git push を deny (block-pre-push.sh)。SubagentStart で launch attestation を書き、SubagentStop で report / hash 検証を経て code-reviewed / security-reviewed の 2 marker を更新する。マーカー仕様・保証差は plugin README を参照。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/block-pre-push.sh"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^pre-push-review:(code|security)-reviewer$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/auto-mark.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^pre-push-review:(code|security)-reviewer$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/auto-mark.sh"
          }
        ]
      }
    ]
  }
}
