#!/bin/bash
# pre-push-review-reviewer-model
# pre-push-review の code-reviewer / security-reviewer を起動する model を、Fable 週次枠の
# 使用率から決めて出力する判定コマンド。plugin の bin/ に置くため、plugin が有効な間は Bash の
# PATH に載り、`/pre-push-review:review` が起動前に 1 回実行する。
#
# 出力 (stdout、常に 2 行、exit 0):
#   1 行目: 起動 model (fable / opus)
#   2 行目: 判定理由 (超過時は使用率と閾値、不明時は使用率を確認できない旨)
#
# 判定仕様は hooks/scripts/lib/fable-weekly-usage.sh を参照 (block-pre-push.sh と共有する)。
# lib を読み込めない場合も opus を出力する (fail-closed)。

LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)/hooks/scripts/lib/fable-weekly-usage.sh"

# shellcheck source=../hooks/scripts/lib/fable-weekly-usage.sh
if ! source "$LIB" 2>/dev/null; then
  printf 'opus\n'
  printf 'Fable 週次枠の使用率を確認できないため opus で起動します (判定処理 %s を読み込めません)。\n' "$LIB"
  exit 0
fi

reviewer_model_decision
printf '%s\n' "$REVIEWER_MODEL"
printf '%s\n' "$REVIEWER_MODEL_REASON"
exit 0
