{
  "description": "codex-advisor の配送・runner 強制経路: SessionStart / SubagentStart で利用規律を additionalContext として注入する。PreToolUse は rescue / review / advisor の Codex model 起動を role 固有 foreground runner だけに限定し、SubagentStart / SubagentStop が runner の active / retry / terminal 遷移を記録する (advisor-runner の SubagentStop は review cadence attestation footer 行の欠落も retry 対象にする)。Stop は未回収の runner がある間 main session の終了を block する。SessionStart / SessionEnd は同一 session の runner state を lifecycle に沿って掃除する。",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/inject-advisor-rules.sh"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/manage-codex-runners.mjs\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/manage-codex-runners.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/manage-codex-runners.mjs\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/inject-advisor-rules-subagent.sh"
          }
        ]
      },
      {
        "matcher": "^(codex-advisor:(rescue|review|advisor)-runner|codex:codex-rescue)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/manage-codex-runners.mjs\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(codex-advisor:(rescue|review|advisor)-runner|codex:codex-rescue)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/manage-codex-runners.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/manage-codex-runners.mjs\""
          }
        ]
      }
    ]
  }
}
