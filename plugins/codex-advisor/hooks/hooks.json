{
  "description": "codex-advisor の配送・runner 強制経路: SessionStart / SubagentStart で利用規律を additionalContext として注入する。PreToolUse は rescue / review / advisor の Codex model 起動を role 固有 runner だけに限定し、SubagentStart / SubagentStop が runner の active / retry / terminal 遷移を記録し、PostToolUse (SubagentHandback) が hand-back された report の footer / attestation 解析値を runner state に記録する (advisor-runner の SubagentStop は review cadence attestation footer 行の欠落も retry 対象にする)。PermissionDenied は classifier に拒否された runner 起動を記録へ反映し、Stop の block ループを残さない。Stop は background_tasks と runner state を突き合わせ、稼働中の runner には待機を通知し、追跡を失った runner がある間だけ main session の終了を block する。runner state の掃除は SessionEnd と、新しい context で始まる SessionStart (startup / clear) だけが行う。",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/inject-advisor-rules.sh"
          }
        ]
      },
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/manage-codex-runners.mjs\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/manage-codex-runners.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/manage-codex-runners.mjs\""
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "^(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/manage-codex-runners.mjs\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/inject-advisor-rules-subagent.sh"
          }
        ]
      },
      {
        "matcher": "^(codex-advisor:(rescue|review|advisor)-runner|codex:codex-rescue)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/manage-codex-runners.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^SubagentHandback$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/manage-codex-runners.mjs\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(codex-advisor:(rescue|review|advisor)-runner|codex:codex-rescue)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/manage-codex-runners.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/manage-codex-runners.mjs\""
          }
        ]
      }
    ]
  }
}
