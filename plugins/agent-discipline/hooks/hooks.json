{
  "description": "agent-discipline の system prompt 群を 3 経路で配送する。SessionStart で常時適用ルール (物理層 + before 系 + closing keyword) を 1 回注入。UserPromptSubmit と PostToolBatch では auto mode 限定の during/after 自走方針を注入し、UserPromptSubmit では session 初回限定で未コミット変更分類チェックも走らせる",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/inject-always.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/inject-auto.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check-uncommitted-on-session-start.sh"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/inject-auto.sh"
          }
        ]
      }
    ]
  }
}
