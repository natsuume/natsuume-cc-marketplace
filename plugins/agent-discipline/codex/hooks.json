{
  "description": "Codex native discipline for GPT-5.6 Sol/Luna. SessionStart and SubagentStart inject compact runtime-specific guidance; PreToolUse keeps the scoped semantic validator.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${PLUGIN_ROOT}/codex/scripts/inject-session.sh\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${PLUGIN_ROOT}/codex/scripts/inject-subagent.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"${PLUGIN_ROOT}/hooks/scripts/codex-semantic-validator.sh\"",
            "timeout": 75
          }
        ]
      }
    ]
  }
}
