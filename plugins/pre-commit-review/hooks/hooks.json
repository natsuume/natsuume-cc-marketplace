{
  "description": "git commit を未レビューの状態でブロックする",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/block-pre-commit.sh"
          }
        ]
      }
    ]
  }
}
