{
  "name": "natsuume-plugins",
  "owner": {
    "name": "natsuume"
  },
  "metadata": {
    "description": "natsuume's personal Claude Code plugins"
  },
  "renames": {
    "fable-risk-labeler": null,
    "codex-advisor": "cross-model-advisor",
    "pre-merge-codex-review": "pre-merge-cross-review",
    "experimental-agent-discipline": null
  },
  "plugins": [
    {
      "name": "git-guardrails",
      "source": "./plugins/git-guardrails",
      "description": "既定ブランチへの直接 commit / push を禁止する",
      "version": "0.7.5",
      "keywords": ["git", "workflow", "github-flow", "rebase", "default-branch-protection"]
    },
    {
      "name": "enforce-draft-pr",
      "source": "./plugins/enforce-draft-pr",
      "description": "gh pr create に --draft を自動付与する",
      "version": "0.5.8",
      "keywords": ["git", "pr", "draft", "github", "github-flow"]
    },
    {
      "name": "auto-lint-check",
      "source": "./plugins/auto-lint-check",
      "description": "編集後の自動整形と commit 前後の lint を行う",
      "version": "0.8.4",
      "keywords": ["lint", "format", "eslint", "prettier", "ruff", "quality"]
    },
    {
      "name": "pre-push-review",
      "source": "./plugins/pre-push-review",
      "description": "push 前に code / security レビューを強制する",
      "version": "7.0.3",
      "keywords": ["push", "review", "quality", "code-review", "security-review", "subagent", "branch-diff", "pr-diff", "parallel"]
    },
    {
      "name": "pre-push-codex-review",
      "source": "./plugins/pre-push-codex-review",
      "description": "push 前に codex review の完了を強制する",
      "version": "4.0.4",
      "keywords": ["push", "review", "quality", "codex", "openai", "subagent", "branch-diff", "gate"]
    },
    {
      "name": "pre-merge-cross-review",
      "source": "./plugins/pre-merge-cross-review",
      "description": "merge 前の codex review を必須化する",
      "version": "4.0.0",
      "keywords": ["merge", "review", "quality", "codex", "openai", "cross-review", "subagent", "pr-diff", "gate"]
    },
    {
      "name": "update-default-branch",
      "source": "./plugins/update-default-branch",
      "description": "既定ブランチを最新化し gone ブランチを削除する",
      "version": "0.4.7",
      "keywords": ["git", "pull", "prune", "branch-cleanup", "merge"]
    },
    {
      "name": "natsuume-statusline",
      "source": "./plugins/natsuume-statusline",
      "description": "git 状態と使用量を表示する statusLine",
      "version": "0.11.5",
      "keywords": ["statusline", "ui", "git", "ratelimit", "github"]
    },
    {
      "name": "agent-discipline",
      "source": "./plugins/agent-discipline",
      "description": "作業規律を注入し issue / PR 本文の独断を検知する",
      "version": "3.0.5",
      "keywords": ["system-prompt", "discipline", "auto", "issue-driven", "bash", "decompose", "askuserquestion", "permission-mode", "hook", "guardrail", "exclusive-claim", "race-condition", "semantic-validation", "pre-tool-use", "agent-hook"]
    },
    {
      "name": "ui-discipline",
      "source": "./plugins/ui-discipline",
      "description": "UI 実装規律の常時注入と実装パターンを提供する",
      "version": "0.4.8",
      "keywords": ["ui", "frontend", "discipline", "system-prompt", "component", "accessibility", "layout-shift", "design-tokens", "hook", "skill"]
    },
    {
      "name": "natsuume-writing",
      "source": "./plugins/natsuume-writing",
      "description": "natsuume の文体規則と文章作成一般の規則で執筆を支援する",
      "version": "0.9.1",
      "keywords": ["writing", "tech-blog", "technical-writing", "style-guide", "system-prompt", "hook", "skill"]
    },
    {
      "name": "cross-model-advisor",
      "source": "./plugins/cross-model-advisor",
      "description": "Codex と Fable へ並列相談し runner を管理する",
      "version": "5.0.9",
      "keywords": ["codex", "fable", "advisor", "second-opinion", "system-prompt", "hook", "skill", "openai"]
    },
    {
      "name": "rate-limit",
      "source": "./plugins/rate-limit",
      "description": "Claude / Codex の rate limit を取得する",
      "version": "0.5.4",
      "keywords": ["rate-limit", "usage-limit", "statusline", "oauth", "skill", "codex"]
    },
    {
      "name": "session-handoff",
      "source": "./plugins/session-handoff",
      "description": "context 閾値超過時に handoff を作成・引き継ぐ",
      "version": "0.5.3",
      "keywords": ["session-handoff", "context-window", "handoff", "session-start", "statusline", "cache", "hook", "skill"]
    },
    {
      "name": "repo-analytics",
      "source": "./plugins/repo-analytics",
      "description": "AI タスクのリードタイム推移を分析・報告する",
      "version": "0.2.9",
      "keywords": ["analytics", "leadtime", "github", "metrics", "report"]
    },
    {
      "name": "enforce-japanese-response",
      "source": "./plugins/enforce-japanese-response",
      "description": "英語の応答を検知し日本語で書き直させる",
      "version": "0.1.0",
      "keywords": ["language", "japanese", "response", "stop", "hook"]
    }
  ]
}
